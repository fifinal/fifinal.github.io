---
import { profil, navigasi } from '../data/situs';

interface Props {
  beranda?: boolean;
}
const { beranda = false } = Astro.props;

// Di halaman detail, tautan navigasi harus kembali ke beranda dulu.
const awalan = beranda ? '' : '/';
---

<header>
  <div class="wrap">
    <nav>
      <a href={beranda ? '#top' : '/'} class="logo">
        {profil.logo.depan}<span>{profil.logo.belakang}</span>
      </a>

      <ul class="nav-links" id="navLinks">
        {
          navigasi.map((n) => (
            <li>
              <a href={n.href ?? `${awalan}#${n.anchor}`}>{n.teks}</a>
            </li>
          ))
        }
      </ul>

      <div class="nav-kanan">
        <button class="tema-btn" id="temaBtn" type="button" aria-label="Ganti tema gelap atau terang">
          <svg class="ikon-matahari" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
            ></path>
          </svg>
          <svg class="ikon-bulan" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
          </svg>
        </button>

        <button class="menu-btn" id="menuBtn" aria-label="Buka menu" aria-expanded="false">☰</button>
      </div>
    </nav>
  </div>
</header>
