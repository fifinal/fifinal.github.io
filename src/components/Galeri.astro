---
/**
 * Galeri tangkapan layar.
 *
 * Halaman detail hanya memanggil komponen ini bila berkas gambarnya
 * benar-benar ada di public/gambar/ — pemeriksaannya di `[slug].astro`.
 *
 * Catatan di bawah galeri sengaja menyebut apa yang benar-benar
 * dilakukan: layar yang dipilih memang hanya memuat data agregat.
 * Jangan diganti menjadi "data telah diganti dengan data contoh"
 * kecuali itu memang yang dikerjakan — lihat Keputusan No. 8.
 */
interface Props {
  gambar: { file: string; keterangan: string }[];
  kerahasiaan: string;
}
const { gambar, kerahasiaan } = Astro.props;
const [utama, ...sisa] = gambar;
---

<div class="gallery">
  <figure>
    <div class="shot">
      <img src={`/gambar/${utama.file}`} alt={utama.keterangan} loading="lazy" decoding="async" />
    </div>
    <figcaption>{utama.keterangan}</figcaption>
  </figure>
</div>

{
  sisa.length > 0 && (
    <div class="gallery gallery-2" style="margin-top:24px">
      {sisa.map((g) => (
        <figure>
          <div class="shot">
            <img src={`/gambar/${g.file}`} alt={g.keterangan} loading="lazy" decoding="async" />
          </div>
          <figcaption>{g.keterangan}</figcaption>
        </figure>
      ))}
    </div>
  )
}

<p class="note">
  Nama, nomor induk, foto, dan data pribadi {kerahasiaan} ditutup pada tangkapan layar di atas. Layar
  yang isinya tidak menyisakan apa pun setelah disensor tidak diterbitkan sama sekali.
</p>
