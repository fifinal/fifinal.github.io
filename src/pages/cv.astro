---
/**
 * Halaman CV — /cv/
 *
 * Dirancang untuk dua keadaan sekaligus: dibaca di layar seperti halaman
 * lain, dan dicetak ke A4 tanpa perubahan isi — gaya cetaknya ada di
 * blok @media print pada global.css.
 *
 * Tombol "Unduh PDF" membentuk berkasnya di peramban pengunjung saat
 * ditekan (lihat skrip di bawah), jadi tidak ada berkas PDF yang
 * disimpan maupun diterbitkan.
 */
import Dasar from '../layouts/Dasar.astro';
import { profil, sosial } from '../data/situs';
import { cv } from '../data/cv';

const tautanHidup = sosial.filter((s) => s.url !== '#');
---

<Dasar
  judul={`CV — ${cv.namaLengkap}`}
  deskripsi={`Curriculum vitae ${cv.namaLengkap}, ${cv.peran}. Pengalaman, keahlian, dan pendidikan.`}
>
  <main>
    <div class="wrap cv-halaman">
      <!-- ============ KEPALA ============ -->
      <header class="cv-kepala reveal">
        {
          cv.foto && (
            <img class="cv-foto" src={cv.foto} alt={`Foto ${cv.namaLengkap}`} width="120" height="120" />
          )
        }

        <div class="cv-kepala-teks">
          <span class="label">Curriculum Vitae</span>
          <h1>{cv.namaLengkap}</h1>
          <p class="cv-peran">{cv.peran}</p>

          <ul class="cv-kontak">
            <li>{cv.lokasi}</li>
            <li><a href={`mailto:${profil.email}`}>{profil.email}</a></li>
            {tautanHidup.map((s) => (
              <li>
                <a href={s.url} target="_blank" rel="noopener">{s.teks}</a>
              </li>
            ))}
          </ul>
        </div>

        <div class="cv-aksi">
          <button class="btn btn-primary" id="unduhCv" type="button">
            <svg viewBox="0 0 24 24" aria-hidden="true" class="cv-ikon">
              <path d="M12 3v12"></path>
              <path d="m7 11 5 5 5-5"></path>
              <path d="M4 20h16"></path>
            </svg>
            <span data-label>Unduh PDF</span>
          </button>
          <a class="btn btn-ghost" href={`mailto:${profil.email}`}>Hubungi saya</a>
        </div>
      </header>

      <!-- ============ ISI ============ -->
      <div class="cv-grid">
        <!-- Kiri -->
        <aside class="cv-samping">
          <section class="cv-blok reveal">
            <h2>Ringkas</h2>
            <p class="cv-ringkas">{cv.ringkas}</p>
          </section>

          <section class="cv-blok reveal">
            <h2>Keahlian</h2>
            {
              cv.keahlian.map((k) => (
                <div class="cv-keahlian">
                  <h3>{k.judul}</h3>
                  <div class="tags">
                    {k.daftar.map((t) => (
                      <span class="tag">{t}</span>
                    ))}
                  </div>
                </div>
              ))
            }
          </section>

          <section class="cv-blok reveal">
            <h2>Pendidikan</h2>
            {
              cv.pendidikan.map((p) => (
                <div class="cv-didik">
                  <h3>{p.judul}</h3>
                  <p class="cv-meta">{p.periode}</p>
                  <p class="cv-tempat">{p.tempat}</p>
                  <p class="cv-ringkas">{p.rincian}</p>
                </div>
              ))
            }
          </section>
        </aside>

        <!-- Kanan -->
        <section class="cv-utama reveal">
          <h2>Pengalaman</h2>

          <div class="timeline">
            {
              cv.pengalaman.map((p) => (
                <article class="item">
                  <div class="item-head">
                    <h3>{p.posisi}</h3>
                    <span class="year">{p.periode}</span>
                  </div>
                  <p class="company">{p.tempat}</p>
                  <p class="cv-ringkas">{p.deskripsi}</p>

                  <div class="tags cv-tags">
                    {p.tags.map((t) => (
                      <span class="tag">{t}</span>
                    ))}
                  </div>

                  {p.sorotan.length > 0 && (
                    <>
                      <span class="cv-subjudul">Sorotan proyek</span>
                      <ul class="cv-sorotan">
                        {p.sorotan.map((s) => (
                          <li>
                            <span class="cv-sorotan-judul">{s.judul}</span>
                            <span class="cv-sorotan-periode">{s.periode}</span>
                            <span class="cv-sorotan-isi">{s.isi}</span>
                          </li>
                        ))}
                      </ul>
                    </>
                  )}
                </article>
              ))
            }
          </div>
        </section>
      </div>
    </div>
  </main>

<script>
  /**
   * Membuat PDF di peramban pengunjung saat tombol ditekan.
   *
   * Pustakanya diimpor secara dinamis — hanya terunduh oleh orang yang
   * benar-benar menekan tombolnya, jadi halaman ini tetap ringan bagi
   * yang cuma membaca.
   *
   * Halaman dipotret jadi gambar lalu ditaruh di atas kertas A4.
   * Konsekuensinya teks di PDF tidak bisa disorot maupun dicari.
   *
   * Tiga hal yang membuat kodenya tidak sesederhana "potret lalu simpan",
   * ketiganya sudah pernah menghasilkan PDF yang salah:
   *
   * 1. html2canvas menyalin gaya TERHITUNG dari halaman ini. Kalau
   *    pengunjung sedang bertema gelap, warna putih ikut tersalin dan
   *    judul jadi putih di atas kertas putih — hilang sama sekali.
   *    Karena itu tema dipaksa terang SEBELUM memotret; menyetelnya di
   *    dalam onclone sudah terlambat.
   * 2. Tata letak layar kalau dipotret jadi gambar setinggi ±1450px dan
   *    terpotong dua halaman di tengah baris. Karena itu aturan
   *    @media print dipasang paksa sementara, dan lebarnya dikunci
   *    718px — lebar isi A4 dikurangi margin 10mm, pada 96dpi.
   * 3. Memotret dari dalam iframe menghasilkan halaman kosong;
   *    html2canvas tidak bisa memotret elemen di dokumen lain. Jadi
   *    yang dipotret memang halaman ini, dan perubahannya ditutupi
   *    lapisan "Menyiapkan…" supaya tidak terlihat berkedip.
   */
  const tombol = document.getElementById('unduhCv');
  const label = tombol?.querySelector('[data-label]');

  /** Mengambil isi seluruh blok @media print dari lembar gaya situs. */
  function aturanCetak() {
    let teks = '';
    for (const lembar of document.styleSheets) {
      let aturan;
      try {
        aturan = lembar.cssRules;
      } catch {
        continue; // lembar dari domain lain, lewati
      }
      for (const a of aturan) {
        const kondisi = a.conditionText || a.media?.mediaText || '';
        if (a.type === CSSRule.MEDIA_RULE && kondisi.includes('print')) {
          for (const dalam of a.cssRules) teks += dalam.cssText + '\n';
        }
      }
    }
    return teks;
  }

  function pasangLapisan() {
    const lapisan = document.createElement('div');
    lapisan.className = 'cv-lapisan';
    lapisan.innerHTML = '<span>Menyiapkan PDF…</span>';
    document.body.appendChild(lapisan);
    return lapisan;
  }

  async function buatPdf() {
    const { default: html2pdf } = await import('html2pdf.js');

    const lapisan = pasangLapisan();
    const temaSemula = document.documentElement.dataset.tema;
    const gaya = document.createElement('style');
    gaya.textContent =
      aturanCetak() + '.cv-halaman{width:718px!important;max-width:718px!important;margin:0}';

    document.documentElement.dataset.tema = 'terang';
    document.head.appendChild(gaya);

    // Beri kesempatan tata letak baru dan fontnya benar-benar terpasang.
    // Sengaja memakai timer, bukan requestAnimationFrame: rAF berhenti
    // total kalau tabnya sedang tidak terlihat, dan prosesnya akan
    // menggantung sampai pengunjung kembali ke tab ini.
    await new Promise((r) => setTimeout(r, 80));
    if (document.fonts?.ready) await document.fonts.ready;

    try {
      return await html2pdf()
        .set({
          margin: 10,
          filename: 'CV-Slamet-Fifin-Alamsyah.pdf',
          image: { type: 'jpeg', quality: 0.95 },
          jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' },
          html2canvas: { scale: 2, backgroundColor: '#ffffff', useCORS: true, logging: false },
        })
        .from(document.querySelector('.cv-halaman'))
        .save();
    } finally {
      gaya.remove();
      if (temaSemula) document.documentElement.dataset.tema = temaSemula;
      else delete document.documentElement.dataset.tema;
      lapisan.remove();
    }
  }

  tombol?.addEventListener('click', async () => {
    if (tombol.disabled) return;
    tombol.disabled = true;
    const semula = label.textContent;
    label.textContent = 'Menyiapkan…';
    try {
      await buatPdf();
      label.textContent = semula;
    } catch (e) {
      console.error(e);
      label.textContent = 'Gagal — coba lagi';
      setTimeout(() => (label.textContent = semula), 2500);
    } finally {
      tombol.disabled = false;
    }
  });
</script>
</Dasar>
