---
import { existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import { getCollection, type CollectionEntry } from 'astro:content';
import Dasar from '../../layouts/Dasar.astro';
import Seksi from '../../components/Seksi.astro';
import Metrik from '../../components/Metrik.astro';
import Galeri from '../../components/Galeri.astro';
import Diagram from '../../components/Diagram.astro';
import Pager from '../../components/Pager.astro';
import { profil } from '../../data/situs';

export async function getStaticPaths() {
  const semua = (await getCollection('proyek')).sort((a, b) => a.data.urutan - b.data.urutan);

  return semua.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      sebelumnya: i > 0 ? semua[i - 1] : null,
      berikutnya: i < semua.length - 1 ? semua[i + 1] : null,
    },
  }));
}

interface Props {
  entry: CollectionEntry<'proyek'>;
  sebelumnya: CollectionEntry<'proyek'> | null;
  berikutnya: CollectionEntry<'proyek'> | null;
}

const { entry, sebelumnya, berikutnya } = Astro.props;
const d = entry.data;

const sebelum = sebelumnya
  ? { url: `/proyek/${sebelumnya.id}/`, judul: sebelumnya.data.judul, arah: 'Proyek sebelumnya' }
  : { url: '/#proyek', judul: 'Semua proyek', arah: 'Kembali' };

const sesudah = berikutnya
  ? { url: `/proyek/${berikutnya.id}/`, judul: berikutnya.data.judul, arah: 'Proyek berikutnya' }
  : { url: '/#kontak', judul: 'Hubungi saya', arah: 'Selanjutnya' };
// Bagian "Arsitektur" hanya muncul bila proyeknya punya diagram, dan
// bagian "Tampilan" hanya bila berkas gambarnya benar-benar ada di
// public/gambar/. Tanpa pemeriksaan itu, galerinya menampilkan kotak
// kosong bertuliskan nama berkas — terbaca seperti halaman rusak,
// justru di halaman yang ditautkan dari CV.
const berkasGambar = (nama: string) =>
  existsSync(fileURLToPath(new URL(`../../../public/gambar/${nama}`, import.meta.url)));

const gambarAda = d.gambar.filter((g) => berkasGambar(g.file));
const adaDiagram = Boolean(d.diagram);
const adaGaleri = gambarAda.length > 0;

// Nomor dihitung dari bagian yang benar-benar tampil, supaya tidak ada
// nomor yang lompat. Urutan properti di bawah menentukan urutannya.
let urut = 0;
const nomor = () => String(++urut).padStart(2, '0');
const label = {
  hasil: `${nomor()} — Hasil kerja`,
  arsitektur: adaDiagram ? `${nomor()} — Arsitektur` : '',
  tampilan: adaGaleri ? `${nomor()} — Tampilan` : '',
  dampak: `${nomor()} — Dampak`,
  refleksi: `${nomor()} — Refleksi`,
};

---

<Dasar judul={`${d.judul} — ${profil.nama}`} deskripsi={d.ringkas}>
  <main>
    <div class="wrap case-hero">
      <div class="breadcrumb">
        <a href="/">Beranda</a><span class="sep">/</span>
        <a href="/#proyek">Proyek</a><span class="sep">/</span>
        <span>{d.judul}</span>
      </div>
      <h1>{d.judul}</h1>
      <p class="lead">{d.lead}</p>
      <div class="tags">{d.tags.map((t) => <span class="tag">{t}</span>)}</div>

      <div class="status-row">
        {
          d.live ? (
            <>
              <a class="live" href={d.live} target="_blank" rel="noopener">
                Situs Live ↗
              </a>
              {/* Sistem multi-tenant punya lebih dari satu alamat hidup.
                  Ditampilkan berlabel institusi, karena di situlah letak
                  buktinya: satu basis kode, beberapa kampus. */}
              {d.liveLain?.map((l) => (
                <a class="live" href={l.url} target="_blank" rel="noopener">
                  {l.label} ↗
                </a>
              ))}
              <span class="status-teks">Kode sumber bersifat privat</span>
            </>
          ) : (
            <>
              <span class="chip">{d.status}</span>
              <span class="status-teks">
                Tidak dapat diakses publik — lihat tangkapan layar di bawah
              </span>
            </>
          )
        }
      </div>

      <dl class="meta">
        <div><dt>Peran</dt><dd>{d.peran}</dd></div>
        <div><dt>Periode</dt><dd>{d.periode}</dd></div>
        <div><dt>Tim</dt><dd>{d.tim}</dd></div>
        <div><dt>Tipe</dt><dd>{d.tipe}</dd></div>
      </dl>
    </div>

    <Seksi label={label.hasil} judul="Fitur utama">
      <ul>{d.fitur.map((l) => <li set:html={l} />)}</ul>
    </Seksi>

    {
      d.diagram && (
        <Seksi label={label.arsitektur} judul="Bentuk sistemnya">
          <Diagram file={d.diagram.file} keterangan={d.diagram.keterangan} />
        </Seksi>
      )
    }

    {
      adaGaleri && (
        <Seksi label={label.tampilan} judul="Cuplikan antarmuka">
          <Galeri gambar={gambarAda} kerahasiaan={d.kerahasiaan} />
        </Seksi>
      )
    }

    <Seksi label={label.dampak} judul="Hasil" lebar>
      <Metrik daftar={d.metrik} />
    </Seksi>

    <Seksi label={label.refleksi} judul="Tantangan & pembelajaran">
      {d.tantangan.map((p) => <p set:html={p} />)}
      <div class="callout">{d.belajar}</div>
    </Seksi>

    <Pager sebelum={sebelum} sesudah={sesudah} />
  </main>
</Dasar>
